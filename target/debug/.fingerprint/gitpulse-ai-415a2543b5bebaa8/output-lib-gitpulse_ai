rom `Super<Self>`.\n"},"level":"error","spans":[{"file_name":"ai\\src\\providers.rs","byte_start":2416,"byte_end":2439,"line_start":98,"line_end":98,"column_start":9,"column_end":32,"is_primary":true,"text":[{"text":"        Self::select(providers)","highlight_start":9,"highlight_end":32}],"label":"`providers::AIProvider` is not dyn compatible","suggested_replacement":null,"suggestion_applicability":null,"expansion":null}],"children":[{"message":"for a trait to be dyn compatible it needs to allow building a vtable\nfor more information, visit <https://doc.rust-lang.org/reference/items/traits.html#dyn-compatibility>","code":null,"level":"note","spans":[{"file_name":"ai\\src\\providers.rs","byte_start":136,"byte_end":146,"line_start":8,"line_end":8,"column_start":11,"column_end":21,"is_primary":false,"text":[{"text":"pub trait AIProvider: Send + Sync {","highlight_start":11,"highlight_end":21}],"label":"this trait is not dyn compatible...","suggested_replacement":null,"suggestion_applicability":null,"expansion":null},{"file_name":"ai\\src\\providers.rs","byte_start":209,"byte_end":217,"line_start":10,"line_end":10,"column_start":14,"column_end":22,"is_primary":true,"text":[{"text":"    async fn generate(&self, prompt: &str) -> Result<String>;","highlight_start":14,"highlight_end":22}],"label":"...because method `generate` is `async`","suggested_replacement":null,"suggestion_applicability":null,"expansion":null}],"children":[],"rendered":null},{"message":"consider moving `generate` to another trait","code":null,"level":"help","spans":[],"children":[],"rendered":null},{"message":"the following types implement `providers::AIProvider`:\n  providers::OllamaProvider\n  providers::OpenRouterProvider\nconsider defining an enum where each variant holds one of these types,\nimplementing `providers::AIProvider` for this new enum and using it instead","code":null,"level":"help","spans":[],"children":[],"rendered":null},{"message":"`providers::AIProvider` may be implemented in oth